FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /boxy-worker ./cmd/boxy-worker

FROM debian:bookworm-slim
LABEL org.opencontainers.image.title="boxy-worker" org.boxy.dev.worker-runtime="instrumented"
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl wget git jq openssh-client gnupg \
    dnsutils iproute2 netcat-openbsd iputils-ping traceroute tcpdump telnet \
    postgresql-client default-mysql-client redis-tools unzip \
    python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG KUBECTL_VERSION=v1.29.14
ARG HELM_VERSION=v3.14.4
ARG KUSTOMIZE_VERSION=v5.3.0
ARG YQ_VERSION=v4.44.1
ARG STERN_VERSION=1.30.0
ARG ARGOCD_VERSION=v2.10.6
ARG TERRAFORM_VERSION=1.8.3
ARG GH_VERSION=2.49.2

RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then KARCH=amd64; else KARCH=arm64; fi && \
    curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KARCH}/kubectl" && chmod +x /usr/local/bin/kubectl && \
    curl -fsSL -o /tmp/helm.tgz "https://get.helm.sh/helm-${HELM_VERSION}-linux-${KARCH}.tar.gz" && \
    tar -xzf /tmp/helm.tgz -C /tmp && mv "/tmp/linux-${KARCH}/helm" /usr/local/bin/helm && rm -f /tmp/helm.tgz && \
    curl -fsSL -o /tmp/kustomize.tgz "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_${KARCH}.tar.gz" && \
    tar -xzf /tmp/kustomize.tgz -C /usr/local/bin && rm -f /tmp/kustomize.tgz && \
    curl -fsSL -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${KARCH}" && chmod +x /usr/local/bin/yq && \
    curl -fsSL -o /tmp/stern.tgz "https://github.com/stern/stern/releases/download/v${STERN_VERSION}/stern_${STERN_VERSION}_linux_${KARCH}.tar.gz" && \
    tar -xzf /tmp/stern.tgz -C /usr/local/bin stern && rm -f /tmp/stern.tgz && \
    curl -fsSL -o /tmp/argocd "https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-${KARCH}" && install -m0755 /tmp/argocd /usr/local/bin/argocd && rm -f /tmp/argocd && \
    curl -fsSL -o /tmp/tf.zip "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${KARCH}.zip" && \
    unzip -o -d /usr/local/bin /tmp/tf.zip && rm -f /tmp/tf.zip && \
    curl -fsSL -o /tmp/gh.tgz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${KARCH}.tar.gz" && \
    tar -xzf /tmp/gh.tgz -C /tmp && mv "/tmp/gh_${GH_VERSION}_linux_${KARCH}/bin/gh" /usr/local/bin/gh && rm -rf /tmp/gh.tgz "/tmp/gh_${GH_VERSION}_linux_${KARCH}" && \
    (curl -fsSL -o /usr/local/bin/kn "https://github.com/knative/client/releases/download/v1.14.0/kn-linux-${KARCH}" && chmod +x /usr/local/bin/kn) || true

RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then AWSARCH=x86_64; else AWSARCH=aarch64; fi && \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSARCH}.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip

RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then GCLOUD=google-cloud-cli-linux-x86_64.tar.gz; else GCLOUD=google-cloud-cli-linux-arm.tar.gz; fi && \
    curl -fsSL -o /tmp/gcloud.tgz "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/${GCLOUD}" && \
    tar -xzf /tmp/gcloud.tgz -C /usr/local && rm -f /tmp/gcloud.tgz && \
    /usr/local/google-cloud-sdk/install.sh --quiet --usage-reporting false --path-update false --command-completion false

ENV PATH="/usr/local/google-cloud-sdk/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev \
  && pip3 install --no-cache-dir --break-system-packages azure-cli==2.61.0 \
  && apt-get purge -y gcc python3-dev \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 65532 boxy && useradd --uid 65532 --gid 65532 --shell /usr/sbin/nologin boxy
COPY --from=build /boxy-worker /usr/local/bin/boxy-worker
RUN chmod 0755 /usr/local/bin/boxy-worker
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/boxy-worker"]
