name: release

on:
  push:
    tags: ['v*.*.*']

env:
  GHCR_ORG: niradler

jobs:
  # -----------------------------------------------------------------------
  # 1. Unit tests (Go + Rust)
  # -----------------------------------------------------------------------
  test:
    name: Unit tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.26.0"

      - run: go vet ./...
      - run: go test ./...

      - uses: dtolnay/rust-toolchain@stable

      - run: cargo test
        working-directory: controller

  # -----------------------------------------------------------------------
  # 2. Full e2e (kind cluster + nsjail sandboxes)
  # -----------------------------------------------------------------------
  e2e:
    name: E2E
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: "1.26.0"

      - name: Install kind
        run: |
          curl -sSLo kind https://kind.sigs.k8s.io/dl/v0.24.0/kind-linux-amd64
          chmod +x kind
          sudo mv kind /usr/local/bin/kind

      - name: Install kubectl
        uses: azure/setup-kubectl@v4

      - name: Install Helm
        uses: azure/setup-helm@v4

      - name: Run e2e
        run: make e2e
        timeout-minutes: 45

  # -----------------------------------------------------------------------
  # 3. Build multi-arch images and push to GHCR + Docker Hub
  # -----------------------------------------------------------------------
  build-push:
    name: Build and push images
    runs-on: ubuntu-latest
    needs: e2e
    permissions:
      contents: write
      packages: write

    steps:
      - uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # --- boxy-router (linux/amd64 + linux/arm64 — pure Go, CGO_ENABLED=0) ---

      - name: Metadata — boxy-router
        id: meta-router
        uses: docker/metadata-action@v5
        with:
          images: |
            ghcr.io/${{ env.GHCR_ORG }}/boxy-router
            ${{ secrets.DOCKERHUB_USERNAME }}/boxy-router
          tags: |
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest

      - name: Build and push boxy-router
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile.router
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta-router.outputs.tags }}
          labels: ${{ steps.meta-router.outputs.labels }}
          cache-from: type=gha,scope=router
          cache-to: type=gha,mode=max,scope=router

      # --- boxy-operator (linux/amd64 + linux/arm64 — pure Go, CGO_ENABLED=0) ---

      - name: Metadata — boxy-operator
        id: meta-operator
        uses: docker/metadata-action@v5
        with:
          images: |
            ghcr.io/${{ env.GHCR_ORG }}/boxy-operator
            ${{ secrets.DOCKERHUB_USERNAME }}/boxy-operator
          tags: |
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest

      - name: Build and push boxy-operator
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile.operator
          platforms: linux/amd64,linux/arm64
          push: true
          tags: ${{ steps.meta-operator.outputs.tags }}
          labels: ${{ steps.meta-operator.outputs.labels }}
          cache-from: type=gha,scope=operator
          cache-to: type=gha,mode=max,scope=operator

      # --- boxy-controller (linux/amd64 only — nsjail compilation; arm64 to be added) ---
      # nsjail must be compiled for the target arch; QEMU-emulated arm64 nsjail builds
      # are too slow for CI (<60 min budget). Native arm64 runners can be added later.

      - name: Metadata — boxy-controller
        id: meta-controller
        uses: docker/metadata-action@v5
        with:
          images: |
            ghcr.io/${{ env.GHCR_ORG }}/boxy-controller
            ${{ secrets.DOCKERHUB_USERNAME }}/boxy-controller
          tags: |
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest

      - name: Build and push boxy-controller
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile.controller
          platforms: linux/amd64
          push: true
          tags: ${{ steps.meta-controller.outputs.tags }}
          labels: ${{ steps.meta-controller.outputs.labels }}
          cache-from: type=gha,scope=controller
          cache-to: type=gha,mode=max,scope=controller

      # --- GitHub Release ---

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
