# syntax=docker/dockerfile:1.7
# NOTE: nsjail uses glibc-specific types (rlimit64, RLIM64_INFINITY) that
# musl (Alpine) does not support. The runtime base is Debian slim (glibc).
# The Rust binary is compiled with musl for a fully static executable.

# Stage 1: Build the Rust controller binary (musl = static, no glibc dep).
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev pkgconfig perl make cmake g++
WORKDIR /build
COPY controller/ .
RUN cargo build --release --bin boxy-controller

# Stage 2: Build nsjail from source (requires glibc headers).
FROM debian:bookworm-slim AS nsjail-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git bison flex \
        libprotobuf-dev libnl-route-3-dev protobuf-compiler \
        g++ make pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth=1 https://github.com/google/nsjail.git /nsjail && \
    cd /nsjail && make -j"$(nproc)"

# Stage 3: Extract Ubuntu 24.04 as the pre-baked sandbox rootfs.
FROM ubuntu:24.04 AS rootfs

# Stage 4: Runtime — Debian slim (glibc, needed by nsjail).
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libprotobuf32 \
        libnl-route-3-200 \
        util-linux \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=nsjail-builder /nsjail/nsjail /usr/sbin/nsjail

# Pre-baked Ubuntu 24.04 rootfs for sandboxes (overlayfs lower dir).
COPY --from=rootfs / /rootfs/ubuntu-24.04

# Static musl Rust binary — runs on any Linux regardless of glibc version.
COPY --from=rust-builder /build/target/release/boxy-controller /usr/local/bin/boxy-controller

ENV BOXY_SANDBOX_PROVIDER=nsjail \
    BOXY_NSJAIL_PATH=/usr/sbin/nsjail \
    BOXY_NSJAIL_ROOTFS=/rootfs/ubuntu-24.04 \
    BOXY_NSJAIL_SANDBOX_ROOT=/var/lib/boxy/sandboxes \
    BOXY_NSJAIL_BINARIES_DIR=/usr/local/bin

RUN mkdir -p /var/lib/boxy/sandboxes

# Requires CAP_SYS_ADMIN (overlayfs). Set in the pod securityContext:
#   capabilities:
#     add: [SYS_ADMIN, SETUID, SETGID, NET_ADMIN, SYS_CHROOT, MKNOD]
USER root

ENTRYPOINT ["/usr/local/bin/boxy-controller"]
