FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /boxy-router ./cmd/boxy-router

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /boxy-router /boxy-router
USER nonroot:nonroot
ENTRYPOINT ["/boxy-router"]
